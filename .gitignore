.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
/build/

# Run artefacts. The state file is the previous run, so it is machine-local.
# The leading slashes matter: a bare `out/` also swallows demo/out/, which is
# where the committed clip lives.
/out/
/state/
/logs/

# Fetched toolchains and demo scratch. demo/out/ is committed on purpose: the
# clip is the deliverable. demo/out-terminal/ is the VHS sibling's output and
# is not committed — regenerate it with `make demo-terminal`.
demo/.toolchain/
demo/.scratch/
demo/out/raw/
demo/out-terminal/
